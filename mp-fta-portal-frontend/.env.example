# Backend connection used by the website (public values — safe in the browser).
# Copy this file to .env and fill in your own backend project's values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF


# Never put private API keys in VITE_* variables — they end up in the browser.
